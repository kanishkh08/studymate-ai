# Copy this file to ".env" (same folder) and fill in your own values.
# NEVER commit the real .env file to GitHub.

# Port the API listens on
PORT=5000

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Replace <username>, <password> and the cluster address. Add a database name like /studymate.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/studymate?retryWrites=true&w=majority

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name. Check https://ai.google.dev/gemini-api/docs/models for the current list.
GEMINI_MODEL=gemini-3.8-flash

# Optional: "low" is faster and cheaper. Leave empty to use the model default.
GEMINI_THINKING_LEVEL=low

# Frontend URL(s) allowed to call this API. Separate several with commas.
# Local development:  http://localhost:5173
# After deployment:   https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Optional: max AI requests per IP every 15 minutes
AI_RATE_LIMIT=40
